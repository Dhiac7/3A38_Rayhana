
{% block body %}
<div class="main-panel">
    <div class="content-wrapper">
        <div class="row justify-content-center">
            <div class="col-12">
                <div class="card shadow-lg border-0 rounded-lg">
                    <div class="mb-4"> {# Margin bottom for spacing #}
                        <div class="table-responsive">
                            <!-- Conteneur des ateliers centré -->
                            <div id="ateliers-table-container" class="d-flex flex-column align-items-center">
                                <!-- Le contenu des ateliers sera chargé ici -->
                                {% include 'atelier/_list_content.html.twig' with {'pagination': pagination} %}
                            </div>
                        </div>
                    </div>
                    <!-- Pagination incluse dans le template partiel -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Script JavaScript pour la suppression AJAX et la pagination AJAX -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    // Fonction pour initialiser les boutons de suppression
    function initDeleteButtons() {
        document.querySelectorAll('.btn-delete').forEach(function (button) {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                let atelierId = this.getAttribute('data-id');

                fetch("{{ path('app_atelier_delete_ajax') }}", {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ id: atelierId }),
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Si la suppression a réussi, tu peux supprimer l'élément de la page
                        document.querySelector(`[data-id='${atelierId}']`).closest('.atelier-card').remove();
                    } else {
                        alert("Erreur lors de la suppression : " + data.message);
                    }
                });
            });
        });
    }

    // Fonction pour initialiser les liens de pagination
    function initPaginationLinks() {
        document.querySelectorAll('#ateliers-table-container .pagination a').forEach(function(link) {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const url = this.getAttribute('href');
                
                // Ajouter un paramètre pour indiquer que c'est une requête AJAX
                const ajaxUrl = url + (url.includes('?') ? '&' : '?') + 'ajax=1';
                
                fetch(ajaxUrl, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.text())
                .then(html => {
                    document.getElementById('ateliers-table-container').innerHTML = html;
                    // Réinitialiser les événements après le chargement du nouveau contenu
                    initDeleteButtons();
                    initPaginationLinks();
                })
                .catch(error => console.error('Erreur lors du chargement de la page:', error));
            });
        });
    }

    // Initialiser les boutons de suppression et les liens de pagination au chargement
    initDeleteButtons();
    initPaginationLinks();
});
</script>
{% endblock %}
