{% extends 'user/client.html.twig' %}

{% block title %}Atelier index{% endblock %}

{% block body %}
    <!-- Start Blog -->
    <div class="blog-area blog-grid default-padding">
        <div class="container">
            <div class="blog-item-box">
                <div class="row">
                    {% for atelier in pagination %}
                        <div class="col-xl-4 col-md-6 single-item">
                            <div class="blog-style-one">
                                <div class="thumb">
                                    <img src="{{ asset('img/atelier/' ~ atelier.photo) }}" style="width: 300px; height: 200px; object-fit: cover; border-radius: 10px;" />
                                </div>
                                <div>
                                    <div class="meta-title">
                                        <span class="post-date">
                                            Date de l'atelier : {{ atelier.dateAtelier ? atelier.dateAtelier|date('d M Y') : 'Date non définie' }}
                                        </span>
                                    </div>
                                    <h3>{{ atelier.nom }}</h3>
                                </div>
                                <div class="info">
                                    <div class="meta">
                                        <ul>
                                            <li>
                                                <p>Description : {{ atelier.description }}</p>
                                            </li>
                                        </ul>
                                    </div>
                                    <div class="atelier-item">
                                        <p><strong>Nom:</strong> {{ atelier.nom }}</p>
                                        <p><strong>Date:</strong> {{ atelier.dateAtelier|date('d M Y') }}</p>
                                        <p><strong>Prix:</strong> {{ atelier.prix }} €</p>
                                <a href="{{ path('choose_seat', { 
                                    'id': atelier.id, 
                                    'nom': atelier.nom, 
                                    'prix': atelier.prix, 
                                    'dateAtelier': atelier.dateAtelier|date('Y-m-d') 
                                }) }}" class="btn btn-primary">Choisir votre place</a>                                    </div>
                                </div>
                            </div>

                            <!-- Like and Dislike Form -->
                            <form action="{{ path('app_atelier_like', {'id': atelier.id}) }}" method="POST">
                                <button type="submit" name="like" value="true" class="btn btn-success">👍 Like</button>
                                <button type="submit" name="like" value="false" class="btn btn-danger">👎 Dislike</button>
                            </form>

                            <!-- Display Like and Dislike Counts -->
                            <p>👍 Likes : {{ atelier.getLikesCount() }}</p>
                            <p>👎 Dislikes : {{ atelier.getDislikesCount() }}</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
    <!-- End Blog -->

    <!-- Pagination -->
    <div class="d-flex justify-content-center">
        {{ knp_pagination_render(pagination) }}
    </div>
    <style>
/* Blog Area */
.blog-area {
    padding: 60px 0;
    background-color: #f9f9f9;
}

/* Container for the blog */
.container {
    max-width: 1200px;
    margin: 0 auto;
}

/* Styling for the blog items */
.blog-item-box {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: space-between;
}

/* Styling for each single blog item (atelier) */
.single-item {
    background-color: #fff;
    border-radius: 10px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    width: 100%;
    transition: transform 0.3s ease;
}

.single-item:hover {
    transform: translateY(-10px);
}

.blog-style-one {
    padding: 20px;
    display: flex;
    flex-direction: column;
}

.thumb {
    margin-bottom: 15px;
    border-radius: 10px;
    overflow: hidden;
}

.thumb img {
    width: 100%;
    height: auto;
    object-fit: cover;
}

/* Title and meta title */
.meta-title {
    margin-bottom: 10px;
}

.meta-title .post-date {
    font-size: 14px;
    color: #777;
}

/* Main atelier name */
h3 {
    font-size: 22px;
    color: #333;
    font-weight: 600;
    margin-bottom: 10px;
}

/* Atelier description */
.info {
    padding-top: 15px;
}

.info .meta {
    margin-bottom: 15px;
}

.info p {
    font-size: 14px;
    color: #555;
}

.atelier-item p {
    font-size: 16px;
    color: #333;
}

.atelier-item .btn-primary {
    background-color: #4CAF50;
    border: none;
    padding: 10px 20px;
    font-size: 16px;
    color: white;
    border-radius: 5px;
    margin-top: 15px;
    transition: background-color 0.3s;
}

.atelier-item .btn-primary:hover {
    background-color: #45a049;
}

/* Like and Dislike buttons */
form {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

form button {
    padding: 8px 12px;
    border-radius: 5px;
    font-size: 14px;
    transition: background-color 0.3s;
}

form .btn-success {
    background-color: #28a745;
    color: white;
}

form .btn-danger {
    background-color: #dc3545;
    color: white;
}

form button:hover {
    opacity: 0.8;
}

/* Pagination */
.d-flex {
    margin-top: 30px;
    justify-content: center;
}

.pagination {
    display: flex;
    list-style: none;
    gap: 10px;
    padding: 0;
}

.pagination li {
    padding: 8px 12px;
    background-color: #007bff;
    color: white;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s;
}

.pagination li:hover {
    background-color: #0056b3;
}

.pagination .active {
    background-color: #0056b3;
}


    </style>
{% endblock %}