{% extends 'base.html.twig' %}

{% block title %}Choisir votre place{% endblock %}

{% block body %}

    <h1>🎟️ Choisissez votre place</h1>

    <div id="seats-container">
        {% set grouped_places = {} %}

        {% for place in places %}
            {% set row = place.code|first %}

            {# Initialisation correcte du tableau pour éviter l'erreur #}
            {% if grouped_places[row] is not defined %}
                {% set grouped_places = grouped_places|merge({ (row): [] }) %}
            {% endif %}

            {# Ajout des places au bon groupe #}
            {% set grouped_places = grouped_places|merge({ (row): grouped_places[row]|merge([place]) }) %}
        {% endfor %}
        {# Affichage des places par rangée #}
{# ... Votre code existant ... #}

{# Formulaire de sélection de place #}
<form method="GET" action="{{ path('app_vente_atelier_new') }}">
    {# Champs cachés pour les paramètres requis #}
    <input type="hidden" name="nom" value="{{ atelier.nom }}">
    <input type="hidden" name="prix" value="{{ atelier.prix }}">
    <input type="hidden" name="dateAtelier" value="{{ atelier.dateAtelier|date('Y-m-d') }}">

    {# Grille des places #}
    <div class="seat-grid">
        {% for row, row_places in grouped_places %}
            <div class="seat-row">
                {% for place in row_places %}
                    <button 
                        type="submit" 
                        name="place" 
                        value="{{ place.code }}" 
                        data-code="{{ place.code }}" 
                        onclick="selectSeat(this)"
                        class="seat-button {% if not place.isAvailable %}disabled{% endif %} {% if app.request.query.get('place') == place.code %}selected{% endif %}" 
                        {% if not place.isAvailable %}disabled{% endif %}
                    >
                        {{ place.code }}
                    </button>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
</form>


{# Message de réservation #}
{% if app.request.query.get('place') %}
    <p class="success-message">Place sélectionnée : {{ app.request.query.get('place') }}</p>
    <a href="{{ path('app_vente_atelier_new', { 
        'nom': atelier.nom, 
        'prix': atelier.prix, 
        'dateAtelier': atelier.dateAtelier|date('Y-m-d'),
        'place': app.request.query.get('place') 
    }) }}" class="btn btn-primary">
        Réserver
    </a>
{% else %}
   <!-- <p class="error-message">Veuillez sélectionner une place.</p>
    <button class="btn btn-disabled" disabled>Réserver</button> -->
{% endif %}
    </div>

    <p id="reservation-message"></p>

            <style>
        /* Conteneur des sièges */
        #seats-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
            align-items: center;
            margin-top: 20px;
        }

        /* Ligne des sièges avec un petit espace entre les rangées */
        .seat-row {
            display: flex;
            gap: 12px;  /* Espacement horizontal entre les boutons */
            justify-content: center;
            margin-bottom: 12px; /* Espacement vertical entre les lignes */
        }

        /* Bouton des places */
        .seat-button {
            padding: 12px 15px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            border: none;
            /* Bouton vert plus foncé */
            background: linear-gradient(135deg, #2E7D32, #388E3C);
            color: white;
            transition: all 0.3s ease;
            box-shadow: 2px 4px 10px rgba(0, 0, 0, 0.2);
            transform: scale(1);
        }

        /* Effet au survol */
        .seat-button:hover {
            background: linear-gradient(135deg, #1B5E20, #2E7D32);
            transform: scale(1.1);
        }

        /* Bouton désactivé (place non disponible) */
        .seat-button.disabled {
            background: linear-gradient(135deg, #E53935, #D32F2F);
            cursor: not-allowed;
            opacity: 0.6;
            box-shadow: none;
        }

        /* Bouton sélectionné */
        .seat-button.selected {
            background: linear-gradient(135deg, #FFC107, #FFA000);
            color: black;
            box-shadow: 0px 0px 12px rgba(255, 193, 7, 0.8);
            transform: scale(1.15);
        }

        /* Message de réservation */
        .success-message {
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            color: #2E7D32;
            background: #C8E6C9;
            padding: 10px;
            border-radius: 8px;
            margin-top: 15px;
        }

        /* Bouton Réserver */
        .btn-primary {
            display: block;
            width: 200px;
            margin: 15px auto;
            padding: 12px;
            text-align: center;
            background: linear-gradient(135deg, #1976D2, #2196F3);
            color: white;
            font-size: 18px;
            font-weight: bold;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.3s;
        }

        /* Effet au survol du bouton Réserver */
        .btn-primary:hover {
            background: linear-gradient(135deg, #1565C0, #1E88E5);
            transform: scale(1.05);
        }
    </style>


    <script>
        let selectedPlace = false;  // Variable JavaScript pour suivre la sélection de la place

        function selectSeat(button) {
            // Si une place est sélectionnée, on définit selectedPlace à true
            selectedPlace = true;

            // Ajout d'un style pour indiquer la sélection
            button.classList.add('selected');

            // Optionnel : afficher la place sélectionnée dans la console ou un autre endroit
            console.log('Place sélectionnée: ' + button.getAttribute('data-code'));
        }
    </script>

    <script src="{{ asset('assetsback/js/seat-selection.js') }}"></script>

{% endblock %}