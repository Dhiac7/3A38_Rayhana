<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rapport Culture Agricole - {{ culture_agricole.nom }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/@mdi/font@7.2.96/css/materialdesignicons.min.css" rel="stylesheet">
<style>
    /* Styles généraux PDF */
    body {
        font-family: Arial, sans-serif;
        font-size: 12px;
        line-height: 1.5;
        color: #333;
        margin: 0;
        padding: 20px;
    }

    .container {
        max-width: 100%;
        margin: 0;
        padding: 0;
        box-shadow: none;
    }

    /* En-tête */
 .header-report {
    margin-bottom: 15px;
    padding-bottom: 15px;
    border-bottom: 2px solid #2c5f2d;
}

.logo {
    max-width: 200px; /* Set a maximum width for the logo */
    max-height: 160px; /* Set a maximum height for the logo */
    height: auto; /* Maintain aspect ratio */
    margin-left: 20px; /* Optional: Add some space between the text and the logo */
}

    h1 {
        font-size: 24px;
        color: #2c5f2d;
        margin: 10px 0;
    }

    h2 {
        font-size: 18px;
        color: #444;
    }

    /* Sections */
    .section {
        margin: 15px 0;
        page-break-inside: avoid;
    }

    .section-title {
        font-size: 14px;
        color: #2c5f2d;
        border-bottom: 1px solid #ddd;
        padding-bottom: 5px;
        margin-bottom: 10px;
    }

    /* Timeline PDF-Friendly */
    .timeline {
        position: relative;
        margin-left: 20px;
        border-left: 2px solid #ddd;
    }

    .timeline-item {
        margin: 15px 0;
        padding-left: 25px;
        position: relative;
    }

    .timeline-point {
        position: absolute;
        left: -9px;
        top: 3px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 2px solid #fff;
        box-shadow: 0 0 0 2px;
    }

    .event-label {
        font-weight: bold;
        margin-bottom: 3px;
    }

    .event-date {
        color: #666;
        font-size: 11px;
    }

    /* Badges simplifiés */
    .badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 3px;
        font-size: 10px;
        margin-top: 5px;
    }

    /* Barre de progression */
    .progress {
        width: 80px;
        height: 8px;
        background: #eee;
        border-radius: 4px;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        background: repeating-linear-gradient(
            45deg,
            transparent,
            transparent 5px,
            rgba(255,255,255,0.3) 5px,
            rgba(255,255,255,0.3) 10px
        );
    }

    /* Couleurs */
    .text-primary { color: #2c5f2d !important; }
    .text-warning { color: #e67e22 !important; }
    .text-danger { color: #c0392b !important; }
    .text-info { color: #2980b9 !important; }

    .bg-primary { background-color: #2c5f2d !important; }
    .bg-warning { background-color: #f1c40f !important; }
    .bg-danger { background-color: #c0392b !important; }
    .bg-info { background-color: #3498db !important; }

    /* Tableaux */
    .list-group-item {
        padding: 8px;
        margin: 5px 0;
        border: 1px solid #ddd;
        border-radius: 4px;
    }
</style>
</head>
<body>
    <div class="container">

<div class="header-report d-flex justify-content-between align-items-center">
    <img src="{{ absolute_url(asset('assetsback/images/logo.png')) }}" alt="Logo" class="logo">

    <div class="text-center">
        <h1>Rapport Culture Agricole</h1>
        <h2>{{ culture_agricole.nom }}</h2>
    </div>
</div>

        <!-- Section Détails Techniques -->
        <div class="section">
            <div class="section-title">
                <i class="mdi mdi-information-outline"></i>
                Détails Techniques
            </div>
            <div class="section-content">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Type :</strong> {{ culture_agricole.type }}</p>
                        <p><strong>Superficie :</strong> {{ culture_agricole.superficie }} ha</p>
                        <p><strong>Rendement Estimé :</strong> {{ culture_agricole.rendementEstime }} kg/ha</p>
                        <p><strong>Statut :</strong> {{ culture_agricole.statut }}</p>
                        <p><strong>Date de Semis :</strong> {{ culture_agricole.dateSemi|date('d M Y') }}</p>

                    </div>
                </div>
            </div>
        </div>

        <!-- Section Parcelles Associées -->
        <div class="section">
            <div class="section-title">
                <i class="mdi mdi-map-marker-outline"></i>
                Parcelles Associées
            </div>
            <div class="section-content">
                {% if culture_agricole.parcelles is not empty %}
                    <div class="list-group">
                        {% for parcelle in culture_agricole.parcelles %}
                            <a href="{{ path('app_parcelle_show2', { id: parcelle.id }) }}" 
                               class="list-group-item list-group-item-action d-flex align-items-center py-3">
                                <i class="mdi mdi-map-marker-outline text-primary me-3 h4"></i>
                                <div>
                                    <h6 class="mb-1">{{ parcelle.nom }}</h6>
                                    <small class="text-muted">Superficie: {{ parcelle.superficie }} ha</small>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="alert alert-light border" role="alert">
                        Aucune parcelle associée
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Section Chronologie -->
        <!-- Section Chronologie -->
        <div class="section">
            <div class="section-title">
                <i class="mdi mdi-timeline-outline"></i>
                Chronologie
            </div>
            <div class="section-content">
                <div class="timeline">
                    {% set all_events = [] %}
                    
                    <!-- Semis -->
                    {% set all_events = all_events|merge([{
                        date: culture_agricole.dateSemi,
                        type: 'semis',
                        label: 'Semis initial',
                        icon: 'mdi-seed',
                        color: 'primary'
                    }]) %}

                    <!-- Traitements -->
                    {% for traitement in traitements_planifies %}
                        {% set all_events = all_events|merge([{
                            date: traitement.date,
                            type: 'traitement',
                            label: traitement.label,
                            icon: 'mdi-spray',
                            color: 'warning',
                            done: traitement.date < now
                        }]) %}
                    {% endfor %}

                    <!-- Récolte -->
                    {% if date_recolte_estimee %}
                        {% set all_events = all_events|merge([{
                            date: date_recolte_estimee,
                            type: 'recolte',
                            label: 'Récolte estimée',
                            icon: 'mdi-sack',
                            color: 'danger',
                            rendement: culture_agricole.rendementEstime * culture_agricole.superficie
                        }]) %}
                    {% endif %}

                    {% set sorted_events = all_events|sort((a, b) => a.date <=> b.date) %}

                    <!-- Affichage des événements -->
                    {% for event in sorted_events %}
                        <div class="timeline-item border-start border-{{ event.color }} ps-4 pb-4 position-relative">
                            <div class="timeline-point bg-{{ event.color }} position-absolute top-0 start-0 translate-middle"></div>
                            <div class="timeline-content">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="text-primary mb-1">
                                            🌱 {{ event.label }}
                                        </h6>
                                        <p class="text-muted mb-0">
                                            {{ event.date|date('d M Y') }}
                                        </p>
                                        {% if event.type == 'traitement' %}
                                            <div class="mt-2">
                                                <span class="badge bg-{{ event.done ? 'success' : 'warning' }}-light text-{{ event.done ? 'success' : 'warning' }}">
                                                    {{ event.done ? '✓ Terminé' : '⌛ En attente' }}
                                                </span>
                                                {% if not event.done %}
                                                    <small class="text-muted ms-2">
                                                        (dans {{ event.date.diff(now).days }} jours)
                                                    </small>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </div>
                                    {% if event.type == 'recolte' %}
                                        <div class="text-end">
                                            <div class="badge bg-danger-light text-danger">
                                                {{ event.rendement|number_format }} kg
                                            </div>
                                            <div class="progress mt-2" style="height: 5px; width: 100px">
                                                {% set progress = ((now.timestamp - culture_agricole.dateSemi.timestamp) / (event.date.timestamp - culture_agricole.dateSemi.timestamp)) * 100 %}
                                                <div class="progress-bar bg-danger" 
                                                    role="progressbar" 
                                                    style="width: {{ progress|round }}%"
                                                    aria-valuenow="{{ progress|round }}" 
                                                    aria-valuemin="0" 
                                                    aria-valuemax="100">
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                    <!-- Prochaine Intervention -->
                    <div class="timeline-item border-start border-info ps-4 pb-4 position-relative">
                        <div class="timeline-point bg-info position-absolute top-0 start-0 translate-middle"></div>
                        <div class="timeline-content">
                            <h6 class="text-info mb-1">
                                <i class="mdi mdi-alert-circle-outline me-2"></i>
                                {% if next_intervention %}
                                    Prochaine intervention : {{ next_intervention.label }}
                                {% else %}
                                    Aucune intervention planifiée
                                {% endif %}
                            </h6>
                            {% if next_intervention %}
                                <p class="text-muted mb-0">
                                    {{ next_intervention.date|date('d M Y') }}
                                    <span class="ms-2 badge bg-info-light text-info">
                                        J-{{ next_intervention.date.diff(now).days }}
                                    </span>
                                </p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer">
        <p>Généré le {{ "now"|date('d M Y') }} - Tous droits réservés.</p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
    /* Timeline Styles */
.timeline {
    position: relative;
    padding-left: 30px;
}

.timeline-item {
    position: relative;
    margin-bottom: 20px;
}

.timeline-point {
    width: 12px;
    height: 12px;
    border-radius: 50%;
}

.timeline-content {
    padding-left: 20px;
}

.progress {
    background-color: #e9ecef;
    border-radius: 10px;
    overflow: hidden;
}
    </style>
</body>
</html>
