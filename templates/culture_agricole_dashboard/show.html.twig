{% extends 'baseAdmin.html.twig' %}

{% block title %}Culture - {{ culture_agricole.nom }}{% endblock %}

{% block body %}
<div class="main-panel">
    <div class="content-wrapper">
        <!-- En-tête conforme à la charte -->
        <div class="page-header">
            <h3 class="page-title">
                <span class="page-title-icon bg-gradient-primary text-white me-2">
                    <i class="mdi mdi-sprout"></i>
                </span>
                {{ culture_agricole.nom }}
            </h3>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Accueil</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Détails culture</li>
                </ol>
            </nav>
        </div>

        <div class="row">
            <!-- Colonne gauche - Détails techniques -->
            <div class="col-lg-8">
                <div class="row">
                    <!-- Carte Rendement -->
                    <div class="col-md-6 grid-margin stretch-card">
                        <div class="card shadow border-0">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h4 class="card-title">Rendement Estimé</h4>
                                        <h2 class="text-primary">{{ culture_agricole.rendementEstime }} <small class="h5">kg/ha</small></h2>
                                    </div>
                                    <div class="bg-gradient-primary p-3 rounded-circle">
                                        <i class="mdi mdi-chart-areaspline text-white h3"></i>
                                    </div>
                                </div>
                                <div class="progress progress-md mt-3 bg-light">
                                    <div class="progress-bar bg-gradient-primary" 
                                         role="progressbar" 
                                         style="width: {{ culture_agricole.rendementEstime / 10 }}%"
                                         aria-valuenow="{{ culture_agricole.rendementEstime }}" 
                                         aria-valuemin="0" 
                                         aria-valuemax="1000">
                                    </div>
                                </div>
                                <br>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h4 class="card-title">Rendement Totale</h4>
                                        <h2 class="text-primary">{{ rendementTotal }} <small class="h5">kg</small></h2>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Carte Statut -->
                    <div class="col-md-6 grid-margin stretch-card">
                        <div class="card shadow border-0">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h4 class="card-title">Statut</h4>
                                        <span class="badge badge-gradient 
                                            {% if culture_agricole.statut == 'en croissance' %}bg-success
                                            {% elseif culture_agricole.statut == 'mature' %}bg-primary
                                            {% elseif culture_agricole.statut == 'récolté' %}bg-info
                                            {% elseif culture_agricole.statut == 'malade' %}bg-danger
                                            {% else %}bg-warning{% endif %} fs-6 p-2">
                                            {{ culture_agricole.statut|capitalize }}
                                        </span>
                                    </div>
                                    <div class="bg-gradient-warning p-3 rounded-circle">
                                        <i class="mdi mdi-heart-pulse text-white h3"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Timeline -->
<!-- Timeline -->
<div class="col-12 grid-margin">
    <div class="card shadow border-0">
        <div class="card-body">
            <h4 class="card-title mb-4">Chronologie des opérations</h4>
            <div class="timeline">

                {# Création d'un tableau unique d'événements triés #}
                {% set all_events = [] %}
                
                {# Ajout du semis #}
                {% set all_events = all_events|merge([{
                    date: culture_agricole.dateSemi,
                    type: 'semis',
                    label: 'Semis initial',
                    icon: 'mdi-seed',
                    color: 'success'
                }]) %}

                {# Ajout des traitements #}
                {% for traitement in traitements_planifies %}
                    {% set all_events = all_events|merge([{
                        date: traitement.date,
                        type: 'traitement',
                        label: traitement.label,
                        icon: 'mdi-spray',
                        color: 'warning',
                        done: traitement.date < now
                    }]) %}
                {% endfor %}

                {# Ajout de la récolte estimée #}
                {% if date_recolte_estimee %}
                    {% set all_events = all_events|merge([{
                        date: date_recolte_estimee,
                        type: 'recolte',
                        label: 'Récolte estimée',
                        icon: 'mdi-sack',
                        color: 'danger',
                        rendement: culture_agricole.rendementEstime * culture_agricole.superficie
                    }]) %}
                {% endif %}

                {# Tri des événements par date #}
                {% set sorted_events = all_events|sort((a, b) => a.date <=> b.date) %}

                {# Affichage de la timeline triée #}
                {% for event in sorted_events %}
                    <div class="timeline-item border-start border-{{ event.color }} ps-4 pb-4 position-relative">
                        <div class="timeline-point bg-{{ event.color }} position-absolute top-0 start-0 translate-middle"></div>
                        <div class="timeline-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="text-{{ event.color }} mb-1">
                                        <i class="mdi {{ event.icon }} me-2"></i>
                                        {{ event.label }}
                                    </h6>
                                    <p class="text-muted mb-0">
                                        {{ event.date|date('d M Y') }}
                                    </p>
                                    {% if event.type == 'traitement' %}
                                        <div class="mt-2">
                                            <span class="badge bg-{{ event.done ? 'success' : 'warning' }}-light text-{{ event.done ? 'success' : 'warning' }}">
                                                {{ event.done ? '✓ Terminé' : '⌛ En attente' }}
                                            </span>
                                            {% if not event.done %}
                                                <small class="text-muted ms-2">
                                                    (dans {{ event.date.diff(now).days }} jours)
                                                </small>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                                {% if event.type == 'recolte' %}
                                    <div class="text-end">
                                        <div class="badge bg-danger-light text-danger">
                                            {{ event.rendement|number_format }} kg
                                        </div>
                                        <div class="progress mt-2" style="height: 5px; width: 100px">
                                            {% set progress = ((now.timestamp - culture_agricole.dateSemi.timestamp) / (event.date.timestamp - culture_agricole.dateSemi.timestamp)) * 100 %}
                                            <div class="progress-bar bg-danger" 
                                                 role="progressbar" 
                                                 style="width: {{ progress|round }}%"
                                                 aria-valuenow="{{ progress|round }}" 
                                                 aria-valuemin="0" 
                                                 aria-valuemax="100">
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}

                {# Bloc prochaine intervention fixe en bas #}
                <div class="timeline-item border-start border-info ps-4 pb-4 position-relative">
                    <div class="timeline-point bg-info position-absolute top-0 start-0 translate-middle"></div>
                    <div class="timeline-content">
                        <h6 class="text-info mb-1">
                            <i class="mdi mdi-alert-circle-outline me-2"></i>
                            {% if next_intervention %}
                                Prochaine intervention : {{ next_intervention.label }}
                            {% else %}
                                Aucune intervention planifiée
                            {% endif %}
                        </h6>
                        {% if next_intervention %}
                            <p class="text-muted mb-0">
                                {{ next_intervention.date|date('d M Y') }}
                                <span class="ms-2 badge bg-info-light text-info">
                                    J-{{ next_intervention.date.diff(now).days }}
                                </span>
                            </p>
                        {% endif %}
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

                    <!-- Section Parcelles associées -->
                    <div class="col-12 grid-margin">
                        <div class="card shadow border-0">
                            <div class="card-body">
                                <h4 class="card-title mb-4">Parcelles associées</h4>
                                {% if culture_agricole.parcelles is not empty %}
                                    <div class="list-group-flush">
                                        {% for parcelle in culture_agricole.parcelles %}
                                            <a href="{{ path('app_parcelle_show2', { id: parcelle.id }) }}" 
                                               class="list-group-item list-group-item-action d-flex align-items-center py-3">
                                                <i class="mdi mdi-map-marker-outline text-primary me-3 h4"></i>
                                                <div>
                                                    <h6 class="mb-1">{{ parcelle.nom }}</h6>
                                                    <small class="text-muted">Superficie: {{ parcelle.superficie }} ha</small>
                                                </div>
                                            </a>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <div class="alert alert-light border" role="alert">
                                        Aucune parcelle associée
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Colonne droite - Métadonnées -->
            <div class="col-lg-4">
                <div class="card shadow border-0">
                    <div class="card-body">
                        <h4 class="card-title mb-4">Caractéristiques</h4>
                        
                        <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                            <div class="bg-gradient-primary p-3 rounded-circle me-3">
                                <i class="mdi mdi-seed text-white h4"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">Type</small>
                                <h5 class="mb-0">{{ culture_agricole.type }}</h5>
                            </div>
                        </div>

                        <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                            <div class="bg-gradient-primary p-3 rounded-circle me-3">
                                <i class="mdi mdi-ruler-square text-white h4"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">Superficie</small>
                                <h5 class="mb-0">{{ culture_agricole.superficie }} ha</h5>
                            </div>
                        </div>

                        <div class="d-flex align-items-center">
                            <div class="bg-gradient-primary p-3 rounded-circle me-3">
                                <i class="mdi mdi-calendar-clock text-white h4"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">Âge</small>
                                <h5 class="mb-0">{{ date().diff(date(culture_agricole.dateSemi)).days }} jours</h5>
                            </div>
                        </div>
                    </div>
                </div>
                <br>
                <!-- Météo -->
                <div class="card shadow border-0">
                    <div class="card-body">
                        <h4 class="card-title mb-4">Météo à {{ weather.name }}</h4>
                        <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                            <div class="bg-gradient-primary p-3 rounded-circle me-3">
                                <i class="mdi mdi-thermometer text-white h4"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">Température</small>
                                <h5 class="mb-0">{{ weather.main.temp }}°C</h5>
                            </div>
                        </div>

                        <div class="d-flex align-items-center">
                            <div class="bg-gradient-primary p-3 rounded-circle me-3">
                                <i class="mdi mdi-weather-cloudy text-white h4"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block">Conditions</small>
                                <h5 class="mb-0">{{ weather.weather[0].description }}</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>

        <!-- Section Actions -->
        <div class="mt-4">
            <div class="d-flex justify-content-between align-items-center">
                <a href="{{ path('app_culture_agricole_dashboard_index') }}" class="btn btn-light">
                    <i class="mdi mdi-arrow-left me-2"></i>Retour à la liste
                </a>
                <div>
                    <a href="{{ path('app_culture_agricole_dashboard_edit', { id: culture_agricole.id }) }}" 
                       class="btn btn-gradient-warning me-2">
                        <i class="mdi mdi-pencil-outline me-2"></i>Modifier
                    </a>
                                        <!-- PDF Download Button -->
                    <a href="{{ path('pdf', {'id': culture_agricole.id}) }}" 
                    class="btn btn-gradient-info me-2" 
                    target="_blank">
                        <i class="mdi mdi-file-pdf-box me-2"></i>Télécharger PDF
                    </a>

                    <button class="btn btn-gradient-danger" 
                            data-bs-toggle="modal" 
                            data-bs-target="#deleteModal">
                        <i class="mdi mdi-trash-can-outline me-2"></i>Supprimer
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Suppression -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header bg-gradient-primary text-white">
                <h5 class="modal-title"><i class="mdi mdi-alert-circle-outline me-2"></i>Confirmation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer définitivement :</p>
                <h5 class="text-primary mb-0">"{{ culture_agricole.nom }}"</h5>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
                <form method="post" action="{{ path('app_culture_agricole_dashboard_delete', {'id': culture_agricole.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ culture_agricole.id) }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="mdi mdi-delete-forever-outline me-2"></i>Confirmer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline {
        position: relative;
    }
    .timeline-point {
        width: 16px;
        height: 16px;
        border-radius: 50%;
    }
    .list-group-item-action:hover {
        background: #f8f9fa;
        transform: translateX(5px);
        transition: all 0.3s ease;
    }
</style>
{% endblock %}