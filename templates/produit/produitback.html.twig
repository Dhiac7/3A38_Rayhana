{% extends 'baseAdmin.html.twig' %}

{% block title %}Gestion des Produits{% endblock %}

{% block body %}
<div class="main-panel">
    <div class="content-wrapper">
        {# Alertes Flash #}
        <div class="flash-container">
            {% for message in app.flashes('prediction') %}
                <div class="alert alert-info alert-dismissible fade show mb-4">
                    <i class="fas fa-chart-line me-2"></i>
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
            
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show mb-4">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card shadow-lg border-0 rounded-lg">
                    <div class="card-header py-3" style="background-color: #49a760; color: white;">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="card-title mb-0">Gestion des Produits</h4>
                            <a href="{{ path('app_produitback_new') }}" class="btn" style="background-color: #fff; color: #2F4F4F;">
                                <i class="fas fa-plus me-2"></i> Nouveau Produit
                            </a>
                        </div>
                    </div>

                    <div class="card-body p-4" style="background-color: #fff;">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr style="background-color: #8FBC8F; color: #2F4F4F;">
                                        <th>Nom du stock</th>
                                        <th>Nom du produit</th>
                                        <th>Image</th>
                                        <th>Quantité</th>
                                        <th>Prix Vente</th>
                                        <th>Prédiction</th>
                                        <th>Catégorie</th>
                                        <th class="text-center">Promotion</th>
                                        <th>Statut</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for produit in produits %}
                                    <tr>
                                        <td>{{ produit.stock.nom }}</td>
                                        <td>{{ produit.nom }}</td>
                                        <td>
                                            {% if produit.image %}
                                                <img src="{{ asset('img/stock/' ~ produit.image) }}" 
                                                     alt="Image {{ produit.nom }}" 
                                                     class="img-thumbnail" 
                                                     style="max-width: 120px; height: auto;">
                                            {% else %}
                                                <span class="text-muted">Aucune image</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ produit.quantite }}</td>
                                        <td>{{ produit.prixVente|format_currency('EUR') }}</td>
                                        <td>
                                            {% if produit.quantitePredite %}
                                                <span class="badge bg-primary">
                                                    {{ produit.quantitePredite }} unités/heures
                                                </span>
                                            {% else %}
                                                <span class="text-muted">N/A</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ produit.categorie }}</td>
                                        <td class="text-center">
                                            {% if produit.enPromotion %}
                                                <i class="mdi mdi-check-circle text-success fs-4"></i>
                                            {% else %}
                                                <i class="mdi mdi-close-circle text-danger fs-4"></i>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="badge 
                                                {% if produit.statut == 'Disponible' %}bg-success
                                                {% elseif produit.statut == 'En rupture' %}bg-danger
                                                {% else %}bg-warning
                                                {% endif %}">
                                                {{ produit.statut }}
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a href="{{ path('app_produitback_show', {'id': produit.id}) }}" 
                                                   class="btn btn-sm btn-light" 
                                                   title="Voir">
                                                    <i class="mdi mdi-eye"></i>
                                                </a>
                                                <a href="{{ path('app_produit_edit', {'id': produit.id}) }}" 
                                                   class="btn btn-sm btn-light" 
                                                   title="Modifier">
                                                    <i class="mdi mdi-pencil"></i>
                                                </a>
                                                <form method="post" 
                                                      action="{{ path('app_produit_delete', {'id': produit.id}) }}" 
                                                      onsubmit="return confirm('Confirmer la suppression ?')">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                                                    <button type="submit" 
                                                            class="btn btn-sm btn-light" 
                                                            title="Supprimer">
                                                        <i class="mdi mdi-delete text-danger"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    {% else %}
                                    <tr>
                                        <td colspan="10" class="text-center py-4">
                                            <div class="alert alert-light">
                                                <i class="fas fa-box-open me-2"></i>
                                                Aucun produit enregistré
                                            </div>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}