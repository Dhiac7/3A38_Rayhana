<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chatbot Agriculture 🌾</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        /* Appliquer un style scrollable si plus de 5 questions */
        #questions-list {
            max-height: 300px;
            overflow-y: auto;
        }

        .question-btn {
            text-align: left;
            width: 100%;
        }
    </style>
</head>
<body class="bg-light">
<div class="container mt-5">
    <h1 class="text-center">Chatbot Agriculture 🌾</h1>
    <div class="card">
        <div class="card-body">
            <!-- Bouton pour afficher la liste des questions -->
            <button id="show-questions-btn" class="btn btn-info mb-3">Afficher les questions possibles</button>

            <!-- Liste des questions cachée par défaut -->
            <div id="questions-list" style="display: none;">
                <ul id="questions" class="list-group mb-3">
                    <!-- Les questions seront injectées ici dynamiquement -->
                </ul>
            </div>

            <!-- Zone des messages -->
            <div id="messages" class="mb-3" style="height: 300px; overflow-y: scroll; border: 1px solid #ccc; padding: 10px;"></div>

            <!-- Champ de saisie et bouton -->
            <input type="text" id="user-input" class="form-control" placeholder="Posez votre question...">
            <button id="send-button" class="btn btn-success mt-2">Envoyer</button>
        </div>
    </div>

    <!-- Bouton Retour à la Dashboard -->
    <div class="text-center mt-4">
        <a href="/dashboard" class="btn btn-primary">Retour à la Dashboard</a>
    </div>
</div>

<script>
    $(document).ready(function () {
        var questionsList = {{ questions | json_encode() | raw }};
        
        $('#show-questions-btn').click(function () {
            $('#questions-list').toggle();
            if ($('#questions').children().length === 0) {
                var questionsHtml = '';
                $.each(questionsList, function (question, answer) {
                    questionsHtml += '<li class="list-group-item"><button class="question-btn btn btn-link">' + question + '</button></li>';
                });
                $('#questions').html(questionsHtml);
            }
        });

        $(document).on('click', '.question-btn', function () {
            var question = $(this).text();
            $('#messages').append('<div><strong>Vous:</strong> ' + question + '</div>');
            $('#user-input').val(question);

            $.ajax({
                url: '/chatbot',
                type: 'POST',
                data: {message: question},
                success: function (response) {
                    $('#messages').append('<div><strong>Bot:</strong> ' + response.message + '</div>');
                },
                error: function () {
                    $('#messages').append('<div><strong>Bot:</strong> Une erreur est survenue.</div>');
                }
            });
        });

        $('#send-button').click(function () {
            var userInput = $('#user-input').val();
            $('#messages').append('<div><strong>Vous:</strong> ' + userInput + '</div>');
            $('#user-input').val('');

            $.ajax({
                url: '/chatbot',
                type: 'POST',
                data: {message: userInput},
                success: function (response) {
                    $('#messages').append('<div><strong>Bot:</strong> ' + response.message + '</div>');
                },
                error: function () {
                    $('#messages').append('<div><strong>Bot:</strong> Une erreur est survenue.</div>');
                }
            });
        });
    });
</script>
</body>
</html>
